<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: cloud backup and device-to-device transfer of the saved setup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
